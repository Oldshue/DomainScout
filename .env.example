# DomainScout — copy to .env and fill in

# ── GoDaddy API (recommended — faster than browser scraping) ──────────────────
# Register free at: https://developer.godaddy.com/keys
# Create an "OTE" or "Production" key — takes 2 minutes
GODADDY_API_KEY=
GODADDY_API_SECRET=

# Optional live bid overlay. This launches a real headed Chrome window because
# GoDaddy blocks headless clients. Leave unset for a non-disruptive desktop.
# DOMAINSCOUT_ENABLE_HEADED_LIVE_BIDS=1

# Complete daily dropped-domain feed (gTLD + ccTLD) used by Expired views.
WHOISFREAKS_API_KEY=
DOMAINSCOUT_DROP_FEED_TLDS=.ai,.com,.sh,.md,.bio
DOMAINSCOUT_DROP_FEED_ENABLED=1
# Re-check provider freshness four times daily; already-complete days are skipped.
DOMAINSCOUT_DROP_FEED_CRON=20 1,7,13,19 * * *
DOMAINSCOUT_DROP_FEED_INITIAL_DAYS=90

# Optional: require registrar API confirmation before showing expired availability
# for specific TLDs. Empty/default uses public DNS/RDAP/WHOIS verification.
# DOMAINSCOUT_REQUIRE_REGISTRAR_TLDS=.com

# ── ICANN CZDS (zone files for full registered-name research) ────────────────
# Register free at: https://czds.icann.org
# Request access to every TLD you want indexed. DomainScout downloads those
# zone files into data/zones, parses every registered second-level name into
# data/zone_index.db, then Research can answer queries like "agent%" instantly.
# Without this index, Research only sees local auction/discovery rows plus
# per-name DNS checks; it cannot discover the full universe of registered names.
CZDS_USER=
CZDS_PASS=

# ── Chromium path (optional — auto-detected if not set) ──────────────────────
# Only needed if playwright can't find Chromium automatically
# CHROMIUM_PATH=/opt/homebrew/bin/chromium

# ── Port ─────────────────────────────────────────────────────────────────────
PORT=3737

# ── Cloud-native registration-universe pull (Railway is the system of record) ─
# Set to 1 to let this deployment itself pull CZDS zone files daily, diff them,
# build/import the universe summary, and publish /api/universe/health. Requires
# CZDS_USER/CZDS_PASS above. Desktop/launchd lanes are mirrors only.
# DOMAINSCOUT_UNIVERSE_PULL_ENABLED=1
# Cron schedule (UTC) for the daily pull; CZDS zone files regenerate ~06:00 UTC.
# DOMAINSCOUT_UNIVERSE_PULL_CRON=40 6 * * *
# Concurrent zone downloads/sorts during a pull (default 6).
# DOMAINSCOUT_UNIVERSE_PULL_CONCURRENCY=6
# Comma-separated anchor zones that must be present or the day is incomplete
# and is never diffed, summarized, or reported as the universe.
# DOMAINSCOUT_UNIVERSE_ANCHOR_ZONES=com,net,org,xyz,app,dev,top,shop,info,online,site,store,tech,club,live
