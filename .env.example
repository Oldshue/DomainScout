# DomainScout — copy to .env and fill in

# ── GoDaddy API (recommended — faster than browser scraping) ──────────────────
# Register free at: https://developer.godaddy.com/keys
# Create an "OTE" or "Production" key — takes 2 minutes
GODADDY_API_KEY=
GODADDY_API_SECRET=

# Optional live bid overlay. This launches a real headed Chrome window because
# GoDaddy blocks headless clients. Leave unset for a non-disruptive desktop.
# DOMAINSCOUT_ENABLE_HEADED_LIVE_BIDS=1

# Complete daily dropped-domain feed (gTLD + ccTLD) used by Expired views.
WHOISFREAKS_API_KEY=
DOMAINSCOUT_DROP_FEED_TLDS=.ai,.com,.sh,.md,.bio
DOMAINSCOUT_DROP_FEED_ENABLED=1
# Re-check provider freshness four times daily; already-complete days are skipped.
DOMAINSCOUT_DROP_FEED_CRON=20 1,7,13,19 * * *
DOMAINSCOUT_DROP_FEED_INITIAL_DAYS=90

# Optional: require registrar API confirmation before showing expired availability
# for specific TLDs. Empty/default uses public DNS/RDAP/WHOIS verification.
# DOMAINSCOUT_REQUIRE_REGISTRAR_TLDS=.com

# ── ICANN CZDS (zone files for full registered-name research) ────────────────
# Register free at: https://czds.icann.org
# Request access to every TLD you want indexed. DomainScout downloads those
# zone files into data/zones, parses every registered second-level name into
# data/zone_index.db, then Research can answer queries like "agent%" instantly.
# Without this index, Research only sees local auction/discovery rows plus
# per-name DNS checks; it cannot discover the full universe of registered names.
CZDS_USER=
CZDS_PASS=

# ── Chromium path (optional — auto-detected if not set) ──────────────────────
# Only needed if playwright can't find Chromium automatically
# CHROMIUM_PATH=/opt/homebrew/bin/chromium

# ── Port ─────────────────────────────────────────────────────────────────────
PORT=3737

# ── Cloud-native registration-universe pull (Railway is the system of record) ─
# Set to 1 to let this deployment itself pull CZDS zone files daily, diff them,
# build/import the universe summary, and publish /api/universe/health. Requires
# CZDS_USER/CZDS_PASS above. Desktop/launchd lanes are mirrors only.
# DOMAINSCOUT_UNIVERSE_PULL_ENABLED=1
# Cron schedule (UTC) for the daily pull; CZDS zone files regenerate ~06:00 UTC.
# DOMAINSCOUT_UNIVERSE_PULL_CRON=40 6 * * *
# Concurrent zone downloads/sorts during a pull (default 6).
# DOMAINSCOUT_UNIVERSE_PULL_CONCURRENCY=6
# Comma-separated anchor zones that must be present or the day is incomplete
# and is never diffed, summarized, or reported as the universe.
# DOMAINSCOUT_UNIVERSE_ANCHOR_ZONES=com,net,org,xyz,app,dev,top,shop,info,online,site,store,tech,club,live

# ── Exact zone truth for every label (extensions-taken counts) ───────────────
# The daily universe summary carries labels present in 2+ zones AND, when this
# is enabled (default 1), every label present in exactly ONE non-anchor zone.
# A label absent from the summary is then exactly "in no zone except possibly
# an anchor", so the accuracy worker needs DNS only for the non-zone extensions
# plus the anchor(s), never for the whole universe. Set to 0 to build legacy
# multi-zone-only tapes (absent labels fall back to a full DNS pass).
# DOMAINSCOUT_UNIVERSE_SINGLE_ZONE_MEMBERSHIP=1
# Comma-separated zones excluded from the single-zone table to bound disk/RAM
# (.com alone is ~150M labels). Each anchor costs one DNS lookup per absent
# label. Default: com.
# DOMAINSCOUT_UNIVERSE_SINGLE_ZONE_ANCHORS=com

# ── Authoritative-direct DNS (extensions-taken probes) ──────────────────────
# For label.tld the accuracy worker asks the TLD's own nameservers directly
# (no recursion, raw UDP). NXDOMAIN → not registered; a referral/NS for the
# exact label → registered; anything ambiguous falls back to the recursive/DoH
# path and is never guessed. Set to 0 to use the recursive path only.
# DOMAINSCOUT_AUTHORITATIVE_DNS=1
# Per-query timeout and retries against a TLD's servers before falling back.
# DOMAINSCOUT_AUTHORITATIVE_DNS_TIMEOUT_MS=1500
# DOMAINSCOUT_AUTHORITATIVE_DNS_RETRIES=1
# UDP socket pool size and total in-flight query ceiling across all sockets.
# DOMAINSCOUT_AUTHORITATIVE_DNS_SOCKETS=4
# DOMAINSCOUT_AUTHORITATIVE_DNS_MAX_INFLIGHT=2000
# Token bucket per authoritative server IP (queries/second and burst). Load is
# spread round-robin across every server of a TLD.
# DOMAINSCOUT_AUTHORITATIVE_DNS_PER_SERVER_QPS=40
# DOMAINSCOUT_AUTHORITATIVE_DNS_PER_SERVER_BURST=40
# How often each TLD's nameserver IPs are rediscovered (default daily).
# DOMAINSCOUT_AUTHORITATIVE_DNS_NS_REFRESH_MS=86400000
# Per-TLD health: if more than this ratio of the last N probes were ambiguous,
# the TLD routes to fallback for the cooldown period.
# DOMAINSCOUT_AUTHORITATIVE_DNS_HEALTH_WINDOW=50
# DOMAINSCOUT_AUTHORITATIVE_DNS_HEALTH_MAX_UNKNOWN_RATIO=0.5
# DOMAINSCOUT_AUTHORITATIVE_DNS_HEALTH_COOLDOWN_MS=900000
# Also query IPv6 authoritative addresses when discovered (0 = IPv4 only).
# DOMAINSCOUT_AUTHORITATIVE_DNS_IPV6=0

# ── Label-level receipt cache ─────────────────────────────────────────────────
# A verified per-extension result (positive or negative alike) is stored per
# label and reused by every list and view for this long; the same label seen in
# auctions, research and taken-in is never re-probed within the TTL. Only
# extensions older than the TTL are re-probed. Default 7 days.
# DOMAINSCOUT_RECEIPT_TTL_MS=604800000

# ── Pre-verify producer (fill receipts before anyone looks) ──────────────────
# Inventory streams walked as soon as they are imported, ordered soonest
# end/expiry first then display priority within each stream, and interleaved
# with a fair share per stream so closeouts and auctions never starve each
# other. Visible pending rows still jump the queue via on-view promotion.
# TLDS_WORKER_PREVERIFY_STREAMS=godaddy-auction,namecheap-auction,godaddy-closeout
# Optional relative shares as stream:weight pairs (default 1 each), e.g.
# TLDS_WORKER_PREVERIFY_SHARES=godaddy-auction:2,godaddy-closeout:1
